# =============================================================================
# storage-service environment configuration
# =============================================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every ${VAR} referenced in config.yaml MUST be defined here. configx uses
# os.ExpandEnv, so an unset var expands to "" — Load then rejects required
# fields via Validate. This file lists the complete set, so copying it gives
# you a runnable config (after swapping the "change-me" placeholders).
#
# docker-compose: load via `env_file: .env` and mount config.yaml into
# /etc/storage-service/config.yaml (a default configx search path), e.g.:
#
#   services:
#     storage-service:
#       env_file: .env
#       volumes:
#         - ./config.yaml:/etc/storage-service/config.yaml:ro
#
# NOTE: docker-compose `env_file` does NOT support inline `#` comments — a
# trailing "  # foo" would be included in the value. Keep all comments on
# their own line (as this file does).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_GRPC_ADDR=:9000
SERVER_HTTP_ADDR=:8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL via dbx)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=storage_service
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
# prefix for all table names; must match migration scripts
DB_TABLE_PREFIX=stor_

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Storage — general
# -----------------------------------------------------------------------------
STORAGE_UPLOAD_TOKEN_TTL=30m
# HMAC secret for signing upload tokens — generate a random value in prod
STORAGE_UPLOAD_TOKEN_SECRET=change-me-generate-a-random-secret
# 10GB
STORAGE_DEFAULT_QUOTA_BYTES=10737418240
STORAGE_DEFAULT_BUCKET=default
STORAGE_ORPHAN_RETENTION=2h
# 7 days
STORAGE_SOFT_DELETE_RETENTION=168h
# 30 days
STORAGE_DELETED_OWNER_RETENTION=720h

# -----------------------------------------------------------------------------
# Storage — STS credential cache
# Constraints (validated at startup):
#   default_ttl <= max_ttl
#   safety_margin < max_ttl
#   read_refresh_window < safety_margin
# -----------------------------------------------------------------------------
STS_DEFAULT_TTL=15m
STS_MAX_TTL=1h
STS_SAFETY_MARGIN=5m
STS_READ_REFRESH_WINDOW=30s
STS_LOCK_PREFIX=sts:lock
STS_LOCK_TTL=10s
STS_LOCK_TRIES=3
STS_LOCK_WAIT=50ms

# -----------------------------------------------------------------------------
# Storage — CDN runtime limits (GenerateCDNURL)
# Constraint: min_ttl <= default_ttl <= max_ttl
# -----------------------------------------------------------------------------
CDN_DEFAULT_TTL=1h
CDN_MIN_TTL=5m
CDN_MAX_TTL=24h

# -----------------------------------------------------------------------------
# Storage — rate limiting
# Map keys are "<action>:<owner_type>": upload:1 = USER, upload:4 = BUSINESS.
# Two windows per key (short burst + hourly cap), each with window + max.
# -----------------------------------------------------------------------------
RATE_LIMIT_PREFIX=storage:ratelimit
RATE_LIMIT_USER_WINDOW_1M=1m
RATE_LIMIT_USER_MAX_1M=10
RATE_LIMIT_USER_WINDOW_1H=1h
RATE_LIMIT_USER_MAX_1H=200
RATE_LIMIT_BIZ_WINDOW_1M=1m
RATE_LIMIT_BIZ_MAX_1M=100
RATE_LIMIT_BIZ_WINDOW_1H=1h
RATE_LIMIT_BIZ_MAX_1H=2000

# -----------------------------------------------------------------------------
# Storage — providers
# Each account gets its own var namespace; the same vendor can repeat (e.g.
# two Aliyun accounts use ALIYUN_PRIMARY_* and ALIYUN_SECONDARY_*).
# -----------------------------------------------------------------------------

# aliyun-primary (VENDOR_ALIYUN_OSS)
ALIYUN_PRIMARY_NAME=aliyun-primary
ALIYUN_PRIMARY_VENDOR=VENDOR_ALIYUN_OSS
ALIYUN_PRIMARY_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_PRIMARY_ACCESS_KEY=change-me
ALIYUN_PRIMARY_SECRET_KEY=change-me
# role_arn enables STS via GetSTSCredential (optional). Format:
# acs:ram::<account-id>:role/<role-name>. Leave blank to disable STS.
ALIYUN_PRIMARY_ROLE_ARN=
ALIYUN_PRIMARY_BUCKET_NAME=default
ALIYUN_PRIMARY_BUCKET_KEY_PREFIX=uploads/
ALIYUN_PRIMARY_BUCKET_ACL=private

# aws-us-east (VENDOR_AWS_S3)
AWS_USEAST_NAME=aws-us-east
AWS_USEAST_VENDOR=VENDOR_AWS_S3
AWS_USEAST_REGION=us-east-1
AWS_USEAST_ACCESS_KEY=change-me
AWS_USEAST_SECRET_KEY=change-me

# -----------------------------------------------------------------------------
# Third-party — gid-service (snowflake ID generator)
# GID_MODE: module = run in-process; grpc = call a remote gid-service.
# Only module-mode fields are active in config.yaml by default.
# -----------------------------------------------------------------------------
GID_MODE=module
GID_MACHINE_ID=1
GID_START_TIME=2025-01-01T00:00:00Z
# Only used when GID_MODE=grpc:
# GID_TARGET=localhost:9000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
